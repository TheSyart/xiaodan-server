{
  "name": "@xiaodan/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/schema.sql','dist/schema.sql')\"",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3"
  }
}
